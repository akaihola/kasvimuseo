#!/usr/bin/env bash
# Local development commands for application contributors.
# Usage: dev/kasvimuseo <command> [args]
#   db start|stop|status|psql|reset     manage the local PostgreSQL cluster
#   db development [in] [out]          copy a dump with development passwords
#   db restore <file>                  restore a supplied dump
#   db bootstrap                       create an empty database
#   db upgrade-photologue              show historical migration instructions
#   media fetch                        download referenced photos from a configured source
#   app build                          build the development container
#   app run [--runserver] [--publish]   serve the application
#   app manage <args...>                run a Django management command
#   app test [args]                     run the application tests
#   app browser-test [args]             run the browser tests
#   app browser-seed                    create browser test records
#   app coverage [args]                run tests with the coverage gate
#   app shell                          open a shell in the application container
#   docs [--open] [--clean]             build the documentation
#   docs serve [--port N]               serve the built documentation
set -euo pipefail

REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
DEV=$REPO/.dev
PGDATA=$DEV/pgdata
PGSOCK=$DEV/run
PGPORT=${KASVIMUSEO_PG_PORT:-5432}
PGLOG=$DEV/pg.log
DB_NAME=${KASVIMUSEO_DB_NAME:-ylaneenkasvit}
DB_USER=${KASVIMUSEO_DB_USER:-ylaneenkasvit}
# Local connections use trust authentication in this development cluster.
DB_PASSWORD=${KASVIMUSEO_DB_PASSWORD:-development}
# The site password `db development` puts on every account of the dump it
# derives. Local-only by construction: it is written into a file under .dev/
# and no command here sends that file anywhere.
DEV_PASSWORD=${KASVIMUSEO_DEV_PASSWORD:-development}
# The development helper supplies a key that signs only local sessions.
SECRET_KEY=${KASVIMUSEO_SECRET_KEY:-development-only-not-a-production-key}
# Developers can restrict the host names accepted by their local server.
ALLOWED_HOSTS=${KASVIMUSEO_ALLOWED_HOSTS:-*}
DEV_LOGIN=${KASVIMUSEO_DEV_LOGIN-1}
IMAGE=${KASVIMUSEO_IMAGE:-kasvimuseo-dev}

die() { echo "$*" >&2; exit 1; }

# -i always, so piping into `app manage shell` works; -t only with a terminal.
[ -t 0 ] && TTY_FLAGS=-it || TTY_FLAGS=-i

pg_running() { pg_ctl -D "$PGDATA" status >/dev/null 2>&1; }

db_init() {
    [ -f "$PGDATA/PG_VERSION" ] && return
    mkdir -p "$PGSOCK" "$DEV/backups"
    # Local-only cluster reachable through a unix socket inside the repo, so it
    # cannot collide with a system PostgreSQL and needs no passwords.
    initdb -D "$PGDATA" -U "$USER" --auth-local=trust --auth-host=trust \
           --encoding=UTF8 --locale=C.UTF-8 >/dev/null
}

db_start() {
    db_init
    pg_running && return
    mkdir -p "$PGSOCK"
    pg_ctl -D "$PGDATA" -l "$PGLOG" -w \
           -o "-k $PGSOCK -p $PGPORT -c listen_addresses=" start >/dev/null
    psql -h "$PGSOCK" -p "$PGPORT" -U "$USER" -d postgres -tAc \
         "SELECT 1 FROM pg_roles WHERE rolname='$DB_USER'" | grep -q 1 || \
        psql -h "$PGSOCK" -p "$PGPORT" -U "$USER" -d postgres -q -c \
             "CREATE ROLE $DB_USER LOGIN SUPERUSER PASSWORD '$DB_PASSWORD'"
    psql -h "$PGSOCK" -p "$PGPORT" -U "$USER" -d postgres -tAc \
         "SELECT 1 FROM pg_database WHERE datname='$DB_NAME'" | grep -q 1 || \
        psql -h "$PGSOCK" -p "$PGPORT" -U "$USER" -d postgres -q -c \
             "CREATE DATABASE $DB_NAME OWNER $DB_USER"
}

db_stop() { pg_running && pg_ctl -D "$PGDATA" -w -m fast stop >/dev/null || true; }

sanitize_dump() {
    awk -v skip_postgis="${1:-0}" '
        skip_postgis && /^(CREATE|COMMENT ON) EXTENSION.*postgis/ { next }
        skip_postgis && /^COPY public\.spatial_ref_sys/ { skip = 1; next }
        skip { if ($0 == "\\.") skip = 0; next }
        # abstime was removed in PostgreSQL 12, so an index over it cannot be
        # recreated for PostgreSQL 12 and later.
        /^CREATE INDEX .*abstime/ {
            print "Skipping index " $3 ": it uses abstime, removed in PostgreSQL 12." \
                > "/dev/stderr"
            next
        }
        { print }'
}

db_restore() {
    local file=${1:-} started=0
    [ -f "$file" ] || die "usage: dev/kasvimuseo db restore <dump.sql>"
    pg_running || { db_start; started=1; }
    psql -h "$PGSOCK" -p "$PGPORT" -U "$USER" -d postgres -q \
         -c "DROP DATABASE IF EXISTS $DB_NAME" \
         -c "CREATE DATABASE $DB_NAME OWNER $DB_USER"
    local skip_postgis=0
    if grep -qi 'EXTENSION.*postgis' "$file" && ! psql -h "$PGSOCK" -p "$PGPORT" \
            -U "$USER" -d postgres -tAc \
            "SELECT 1 FROM pg_available_extensions WHERE name='postgis'" | grep -q 1; then
        echo "PostGIS is not installed locally; skipping the unused extension." >&2
        skip_postgis=1
    fi
    sanitize_dump "$skip_postgis" < "$file" | \
        psql -h "$PGSOCK" -p "$PGPORT" -U "$DB_USER" -d "$DB_NAME" \
             -v ON_ERROR_STOP=1 -q -o /dev/null
    echo "Restored $file into $DB_NAME" >&2
    [ "$started" = 1 ] && db_stop || true
}

# Create a local dump with development passwords for every account.
# The output retains all other data, so keep it outside Git.
db_development() {
    local src=${1:-$DEV/backups/production.sql}
    local out=${2:-$DEV/backups/development.sql}
    [ -f "$src" ] || die "usage: dev/kasvimuseo db development [dump.sql] [out.sql]
$src does not exist. Take a dump first:
  Provide a dump file as the first argument."
    # Django's own hasher rather than this script's idea of the format: the
    # algorithm and the iteration count belong to the application and move with
    # the Django it runs. -t would put a carriage return in the captured hash.
    local hash TTY_FLAGS=''
    hash=$(app_run_container "" python -c '
import sys
from django.contrib.auth.hashers import make_password
print(make_password(sys.argv[1]))' "$DEV_PASSWORD")
    mkdir -p "$(dirname "$out")"
    awk -v hash="$hash" -v src="$src" '
        BEGIN { FS = OFS = "\t" }
        # Which column holds the password is read from the COPY header, since
        # the dump states it and a position would have to be trusted.
        /^COPY public\.auth_user \(/ {
            header = $0
            sub(/^[^(]*\(/, "", header)
            sub(/\).*$/, "", header)
            fields = split(header, columns, ", ")
            for (i = 1; i <= fields; i++)
                if (columns[i] == "password") column = i
            in_users = 1
            print; next
        }
        in_users && $0 == "\\." { in_users = 0; print; next }
        in_users && column { $column = hash; users++; print; next }
        { print }
        END { if (!users) {
                  print src " has no auth_user rows with a password column" \
                        " -- is it a dump of this database?" > "/dev/stderr"
                  exit 1
              }
              print "Replaced " users " passwords." > "/dev/stderr" }
    ' < "$src" > "$out" || { rm -f "$out"; die "$out was not written."; }
    echo "Wrote $out. Every account in it now has the password '$DEV_PASSWORD':
  dev/kasvimuseo db restore $out" >&2
}

photologue_upgrade() {
    die 'db upgrade-photologue needs South, and upgrade plan Stage 5 removed South.
Give the database the South-era chain from a worktree of the last South
commit -- the one Stage 4 names in its :Resolution: field in
docs/upgrade-plan.rst. From this repository root:

  git worktree add /tmp/stage4 <that commit>
  ln -s "$PWD/.dev" /tmp/stage4/.dev    # the worktree must use THIS cluster
  (cd /tmp/stage4 && KASVIMUSEO_IMAGE=kasvimuseo-dev-south dev/kasvimuseo app build)
  (cd /tmp/stage4 && KASVIMUSEO_IMAGE=kasvimuseo-dev-south dev/kasvimuseo db upgrade-photologue)
  rm /tmp/stage4/.dev && git worktree remove /tmp/stage4
  dev/kasvimuseo app manage migrate     # Django adopts the schema; output says FAKED

Set KASVIMUSEO_IMAGE as shown: a plain `app build` in the worktree would
re-tag kasvimuseo-dev with the old dependencies. Do NOT skip to `migrate`:
Django 1.7 fakes an initial migration when its tables merely exist, so on a
pre-Stage-2 schema it records photologue as migrated with title_slug still
unrenamed, and the application breaks later, not here. Read the original migration instructions in the private deployment repository.'
}

# The printable views need local image files to read their dimensions.
# Fetch the referenced photos with the application interpreter.
#
# The host to fetch from is MEDIA_FALLBACK_URL, not MEDIA_URL: since issue 048
# the development MEDIA_URL is this server's own /media/, and fetching from
# there would ask the dev server for the files it is being given.
media_fetch() {
    with_db app_run_container "" python -c '
import os, sys
from urllib.parse import quote
from urllib.request import urlopen
import django
django.setup()
from django.conf import settings
from photologue.models import Photo

base = settings.MEDIA_FALLBACK_URL or settings.MEDIA_URL
if base.startswith("//"):
    base = "https:" + base
if "://" not in base:
    sys.exit("Neither MEDIA_FALLBACK_URL nor MEDIA_URL names a host to fetch "
             "from; both are local to this installation.")
fetched = failed = present = 0
for name in Photo.objects.values_list("image", flat=True).order_by("image"):
    destination = os.path.join(settings.MEDIA_ROOT, name)
    if os.path.exists(destination):
        present += 1
        continue
    try:
        data = urlopen(base + quote(name), timeout=60).read()
    except Exception as error:
        print("FAILED {0}: {1}".format(name, error))
        failed += 1
        continue
    directory = os.path.dirname(destination)
    if not os.path.isdir(directory):
        os.makedirs(directory)
    with open(destination, "wb") as image_file:
        image_file.write(data)
    fetched += 1
print("{0} fetched, {1} failed, {2} already present".format(
    fetched, failed, present))
'
}

CONTAINER=kasvimuseo-dev-$$
TEST_ENV="-e DJANGO_SETTINGS_MODULE=ylaneenkasvit.test_settings"

# Everything a development checkout needs is in the tracked
# `ylaneenkasvit/development_settings.py` since issue 067. `local_settings.py`
# is untracked, optional, and applied on top of it, so this no longer writes
# one -- but a checkout made before 067 still has the copy this script used to
# make from `local_settings.development.py`, and that copy sets STATIC_URL,
# MEDIA_URL and the rest over the top of the tracked values. It is only a
# shadow, not a breakage, and the shadowed values are the same ones for anybody
# who never edited it; say so once rather than let a divergence be found from a
# browser, which is how both 048 and 067 arrived.
warn_about_local_settings() {
    local settings=$REPO/ylaneenkasvit/local_settings.py
    # Python 2.7 imports a .pyc that has no .py beside it, so deleting only the
    # source leaves the old settings in force, which is why
    # the note below would otherwise be advice that does not work.
    if [ ! -f "$settings" ] && [ -f "$settings"c ]; then
        echo "Note: ylaneenkasvit/local_settings.pyc has no .py beside it and" >&2
        echo "Python 2.7 imports it anyway, so whatever it says is still applied" >&2
        echo "over ylaneenkasvit/development_settings.py. Delete it." >&2
        return 0
    fi
    [ -f "$settings" ] || return 0
    grep -q 'MEDIA_URL\|STATIC_URL' "$settings" || return 0
    echo "Note: ylaneenkasvit/local_settings.py is a copy of the old" >&2
    echo "local_settings.development.py template, and its settings are applied" >&2
    echo "over ylaneenkasvit/development_settings.py, which is tracked and now" >&2
    echo "holds all of them (issue 067). Delete it and its .pyc, or cut it down" >&2
    echo "to whatever is particular to this machine." >&2
}

app_run_container() {
    # Without this, podman treats an unbuilt $IMAGE as a Docker Hub short name,
    # tries to pull docker.io/library/kasvimuseo-dev and fails with "requested
    # access to the resource is denied" -- which reads as a credentials problem
    # and is not one. The image is per machine, not per checkout, so a second
    # machine or a fresh account meets this on its first command.
    podman image exists "$IMAGE" || die \
        "The development image $IMAGE is not built on this machine. Build it:
  dev/kasvimuseo app build
It takes about a minute and a half. Set KASVIMUSEO_IMAGE to use another one."
    warn_about_local_settings
    local extra=$1; shift
    local path target
    local linked_mounts=()
    # External local state must remain reachable through the checkout's links.
    for path in "$DEV" "$REPO/media" "$REPO/static" "$REPO/ylaneenkasvit/local_settings.py"; do
        if [ -L "$path" ]; then
            [ -e "$path" ] || die "Local state link is broken: $path"
            target=$(realpath "$path")
            linked_mounts+=(-v "$target:$target")
        fi
    done
    # Named so the exit trap can reap it: podman leaves the container running if
    # its client process is killed rather than interrupted.
    #
    # DJANGO_SETTINGS_MODULE is passed rather than left to the image's own ENV,
    # so that a change to it takes effect without `app build` (issue 067). The
    # suite and the browser tests name `test_settings` in $extra, which podman
    # applies after this and which therefore wins.
    podman run --rm --name "$CONTAINER" ${TTY_FLAGS:-} \
        -v "$REPO:/src" "${linked_mounts[@]}" \
        -v "$PGSOCK:/var/run/postgresql" \
        -e "DJANGO_SETTINGS_MODULE=ylaneenkasvit.development_settings" \
        -e "KASVIMUSEO_DB_PORT=$PGPORT" \
        -e "KASVIMUSEO_DB_NAME=$DB_NAME" \
        -e "KASVIMUSEO_DB_USER=$DB_USER" \
        -e "KASVIMUSEO_DB_PASSWORD=$DB_PASSWORD" \
        -e "KASVIMUSEO_SECRET_KEY=$SECRET_KEY" \
        -e "KASVIMUSEO_ALLOWED_HOSTS=$ALLOWED_HOSTS" \
        -e "KASVIMUSEO_MEDIA_FALLBACK_URL=${KASVIMUSEO_MEDIA_FALLBACK_URL:-}" \
        -e "KASVIMUSEO_TEST_SUFFIX=${KASVIMUSEO_TEST_SUFFIX:-}" \
        -e "KASVIMUSEO_DEV_LOGIN=$DEV_LOGIN" \
        $extra "$IMAGE" "$@"
}

app_serve() {
    local runserver=0 network=--network=host bind=${KASVIMUSEO_PORT:-8000}
    while [ $# -gt 0 ]; do
        case $1 in
            --runserver) runserver=1 ;;
            --publish)   network=-p\ ${KASVIMUSEO_PORT:-8000}:8000; bind=8000 ;;
            *) die "usage: dev/kasvimuseo app run [--runserver] [--publish]" ;;
        esac
        shift
    done
    if [ "$runserver" = 1 ]; then
        with_db app_run_container "$network" \
            python ylaneenkasvit/manage.py runserver "0.0.0.0:$bind"
    else
        # One worker keeps the log readable and matches runserver's behaviour
        # under a single developer; --timeout is generous because the largest
        # change forms take a couple of seconds and a debugger pauses longer.
        with_db app_run_container "$network" \
            gunicorn ylaneenkasvit.wsgi:application \
                --bind "0.0.0.0:$bind" --workers 1 --timeout 300 \
                --access-logfile - --error-logfile -
    fi
}

# The label editor's browser tests (issue 017). Two interpreters, and that is
# the point: the application is Django 1.5 on Python 2.7, nothing that drives a
# current browser supports 2.7, and the browser this page has to be right in is
# not one a 2020 Chromium can stand in for. So the server is the real
# application in its own container and the tests are Python 3 on the host,
# through uv, talking to it over HTTP -- the same split `docs` already uses.
#
# Two engines as well as two interpreters, since issue 061: every test runs in
# Chromium and again in Playwright's WebKit, which is the engine iOS Safari is
# built on and the one every defect this page has been reported for came from
# (issues 045, 046, 047 and 056). `--engine chromium` or `--engine webkit`
# narrows a run to one, and so does KASVIMUSEO_BROWSER_ENGINES; CI runs one per
# job. WebKit skips the six touch-drag tests, which need a Chrome DevTools
# Protocol call it does not have -- browser_tests/conftest.py says so where it
# skips them.
#
# Everything it touches is thrown away: its own database, seeded from
# browser_tests/seed.py, and its own MEDIA_ROOT under .dev/. The developer's
# ylaneenkasvit database and media/ are not read or written, and neither is
# local_settings.py -- the server runs on ylaneenkasvit.test_settings, which is
# built on common_settings for that reason.
BROWSER_DB=${KASVIMUSEO_BROWSER_DB_NAME:-${DB_NAME}_browsertest}
BROWSER_ENV="-e DJANGO_SETTINGS_MODULE=ylaneenkasvit.test_settings"
BROWSER_ENV="$BROWSER_ENV -e KASVIMUSEO_MEDIA_ROOT=/src/.dev/browser-test-media"

BROWSER_PASSWORD=${KASVIMUSEO_BROWSER_TEST_PASSWORD:-$(
    od -An -N16 -tx1 /dev/urandom | tr -d ' \n')}
BROWSER_ENV="$BROWSER_ENV -e KASVIMUSEO_BROWSER_TEST_PASSWORD=$BROWSER_PASSWORD"

# The server shares the host's network namespace, as `app run` does (issue
# 044), so it needs a port nothing else on this machine is on. Set
# KASVIMUSEO_BROWSER_PORT to pin one.
free_port() {
    local port
    for port in $(seq 8123 8199); do
        (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null && exec 3<&- || {
            echo "$port"; return; }
    done
    die "no free port between 8123 and 8199"
}

# Wipe the browser tests' database back to what seed.py describes. Its own
# command because the tests call it between themselves: the editor's save
# rewrites every label, so a test that saves would otherwise decide what the
# next one sees.
browser_seed() {
    TTY_FLAGS=
    DB_NAME=$BROWSER_DB
    app_run_container "$BROWSER_ENV" python browser_tests/seed.py
}

browser_test() {
    command -v uv >/dev/null 2>&1 || die \
        "app browser-test needs uv on the host: https://docs.astral.sh/uv/"
    # Detached and interactive are a bad pair, and the server runs in the
    # background of this script.
    TTY_FLAGS=
    DB_NAME=$BROWSER_DB
    local port=${KASVIMUSEO_BROWSER_PORT:-$(free_port)}
    pg_running || { db_start; DB_STARTED=1; }
    psql -h "$PGSOCK" -p "$PGPORT" -U "$USER" -d postgres -q \
         -c "DROP DATABASE IF EXISTS $BROWSER_DB" \
         -c "CREATE DATABASE $BROWSER_DB OWNER $DB_USER"
    BROWSER_DB_MADE=1
    # One command since upgrade plan Stage 5: Django's own migrations order
    # themselves, and the photo sizes the labels render -- `display` among
    # them -- are a data migration (issue 055,
    # kasvimuseo/migrations/0002_photo_sizes.py).
    app_run_container "$BROWSER_ENV" \
        python ylaneenkasvit/manage.py migrate --noinput >/dev/null
    browser_seed

    echo "Serving $BROWSER_DB on port $port ..." >&2
    app_run_container "$BROWSER_ENV --network=host" \
        gunicorn ylaneenkasvit.wsgi:application \
            --bind "127.0.0.1:$port" --workers 2 --timeout 60 \
            --access-logfile /dev/null --error-logfile - &
    local url=http://127.0.0.1:$port waited=0
    until curl -sfo /dev/null "$url/kasvimuseo/planting-labels/"; do
        waited=$((waited + 1))
        [ "$waited" -lt 60 ] || die "the server did not answer on $url"
        sleep 0.5
    done

    # --no-project: the repository's own setup.py is a Python 2 package and has
    # nothing to do with these tests.
    KASVIMUSEO_BROWSER_TEST_URL=$url \
    KASVIMUSEO_BROWSER_TEST_SEED="$REPO/dev/kasvimuseo app browser-seed" \
    KASVIMUSEO_BROWSER_TEST_PASSWORD=$BROWSER_PASSWORD \
    uv run --no-project --with-requirements "$REPO/browser_tests/requirements.txt" \
        pytest "$REPO/browser_tests" "$@"
}

# Starts the cluster if needed and stops it again afterwards.
DB_STARTED=0
BROWSER_DB_MADE=0
cleanup() {
    podman rm -f -t 3 "$CONTAINER" >/dev/null 2>&1 || true
    # The browser tests' database outlives nothing: dropped here so a failed run
    # leaves no half-seeded copy behind either.
    [ "$BROWSER_DB_MADE" = 1 ] && pg_running && \
        psql -h "$PGSOCK" -p "$PGPORT" -U "$USER" -d postgres -q \
             -c "DROP DATABASE IF EXISTS $BROWSER_DB" >/dev/null 2>&1 || true
    [ "$DB_STARTED" = 1 ] && db_stop || true
}
trap cleanup EXIT
with_db() {
    pg_running || { db_start; DB_STARTED=1; }
    "$@"
}

case "${1:-}" in
  db)
    case "${2:-}" in
      start)   db_start; echo "PostgreSQL up on $PGSOCK (port $PGPORT)" ;;
      stop)    db_stop; echo "PostgreSQL stopped" ;;
      status)  pg_ctl -D "$PGDATA" status ;;
      psql)    shift 2; with_db psql -h "$PGSOCK" -p "$PGPORT" -U "$DB_USER" -d "$DB_NAME" "$@" ;;
      bootstrap)
               # It takes no dump, and being handed one used to be silent: the
               # argument was dropped and the empty database that came out had
               # no accounts, so the next thing that happened was a login that
               # would not work, with nothing anywhere saying why (issue 067).
               [ $# -le 2 ] || die \
                 "db bootstrap takes no arguments: it builds an empty database from
the migrations. To load the dump instead:
  dev/kasvimuseo db restore $3"
               with_db app_run_container "" \
                 python ylaneenkasvit/manage.py migrate --noinput ;;
      development)
               db_development "${3:-}" "${4:-}" ;;
      restore) db_restore "${3:-}" ;;
      upgrade-photologue)
               photologue_upgrade ;;
      reset)   db_stop; rm -rf "$PGDATA"; echo "Cluster deleted" ;;
      *)       die "usage: dev/kasvimuseo db start|stop|status|psql|development|restore|bootstrap|upgrade-photologue|reset" ;;
    esac ;;
  media)
    case "${2:-}" in
      fetch)   media_fetch ;;
      *)       die "usage: dev/kasvimuseo media fetch" ;;
    esac ;;
  app)
    case "${2:-}" in
      build)   podman build -f "$REPO/dev/Containerfile" -t "$IMAGE" "$REPO" ;;
      run)     shift 2; app_serve "$@" ;;
      manage)  shift 2; with_db app_run_container "" python ylaneenkasvit/manage.py "$@" ;;
      test)    shift 2; with_db app_run_container "$TEST_ENV" \
                   python -m pytest "$@" ;;
      browser-test)
               shift 2; browser_test "$@" ;;
      browser-seed)
               browser_seed ;;
      # Runs the same suite as `app test`, and additionally fails when the
      # total drops below the floor in .coveragerc -- which is where what is
      # measured, what is left out and why 97 are all argued (issue 064). What
      # is measured is not repeated here on purpose: this command and the CI
      # step that calls it must read one definition, not two.
      #
      # The suite is silent while it passes, because the table is what this
      # command is for; if it fails, its output is printed and no coverage is
      # reported, since the number would then be measuring a broken run.
      # Reporting it anyway is what the `;` here used to do, and it turned a
      # red suite into a green-looking table.
      #
      # It costs about a quarter longer than `app test` -- 44 seconds against
      # 35 on a warm cluster here, the tracer being on every line of every
      # request -- which is why it is a second command rather than what
      # `app test` does.
      coverage)
               shift 2; with_db app_run_container "$TEST_ENV" sh -c \
                 "out=\$(coverage run -m pytest -q $* 2>&1) ||
                      { printf '%s\n' \"\$out\" >&2; exit 1; }
                  coverage report -m" ;;
      shell)   with_db app_run_container "" sh ;;
      *)       die "usage: dev/kasvimuseo app build|run|manage|test|browser-test|browser-seed|coverage|shell" ;;
    esac ;;
  docs)
    case "${2:-}" in
      serve)   shift 2; exec "$REPO/dev/docs-serve" "$@" ;;
      *)       shift; "$REPO/dev/docs-build" "$@" ;;
    esac ;;
  *) sed -n '2,/^set /{ /^#/p; }' "${BASH_SOURCE[0]}" | cut -c3- ;;
esac
