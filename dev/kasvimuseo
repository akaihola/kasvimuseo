#!/usr/bin/env bash
# Development helper for Kasvimuseo: throwaway PostgreSQL cluster + Python 2.7
# app container. All state lives under .dev/ and is safe to delete.
#
# Usage: dev/kasvimuseo <command> [args]
#   db start|stop|status|psql|reset     local PostgreSQL cluster
#   db fetch [file]                     dump the production database over SSH
#   db restore <file>                   load a dump into the local database
#   db bootstrap                        empty database from the migrations
#   media fetch                         download the photos the database uses
#   app build                           build the Python 2.7 dev image
#   app run [--runserver] [--publish]   serve the site (on $KASVIMUSEO_PORT)
#   app manage <args...>                run a manage.py command
#   app test [args]                     run the test suite
#   app browser-test [args]             run the label editor's browser tests
#   app browser-seed                    reset their data (they call this)
#   app coverage [args]                 run the test suite and report coverage
#   app shell                           shell inside the app container
#   docs [--open] [--clean]             build the Sphinx docs (on the host)
#   docs serve [--port N]               serve every checkout's docs on the tailnet
#
# `app run`, `app manage` and `app test` start PostgreSQL if it is down and stop
# it again on exit, so the cluster only runs while it is actually needed. The
# tests build their own data, so they need no production dump and no media.
set -euo pipefail

REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
DEV=$REPO/.dev
PGDATA=$DEV/pgdata
PGSOCK=$DEV/run
PGPORT=${KASVIMUSEO_PG_PORT:-5432}
PGLOG=$DEV/pg.log
DB_NAME=${KASVIMUSEO_DB_NAME:-ylaneenkasvit}
DB_USER=${KASVIMUSEO_DB_USER:-ylaneenkasvit}
# Local-only credentials: the throwaway cluster trusts local connections, so
# this password authenticates nothing. It used to be production's, which is why
# it is not any more (issue 025). `db fetch`, the one command that talks to
# production, insists on being given the real one.
DB_PASSWORD=${KASVIMUSEO_DB_PASSWORD:-development}
# Development key for a development server. The production key comes from
# Ansible Vault and is never in this repository; the settings refuse to start
# without KASVIMUSEO_SECRET_KEY, so something has to be passed here.
SECRET_KEY=${KASVIMUSEO_SECRET_KEY:-development-only-not-a-production-key}
# The site settings refuse to start without KASVIMUSEO_ALLOWED_HOSTS too (issue
# 026), and a development server is reached under whatever name its developer
# published it -- localhost, a container IP, a tailnet name. Production's list
# comes from ansible/vars/main.yml and is never this.
ALLOWED_HOSTS=${KASVIMUSEO_ALLOWED_HOSTS:-*}
IMAGE=${KASVIMUSEO_IMAGE:-kasvimuseo-dev}
PROD_SSH=${KASVIMUSEO_PROD_SSH:-kasvimuseo@kasvit.ambitone.com}

die() { echo "$*" >&2; exit 1; }

# -i always, so piping into `app manage shell` works; -t only with a terminal.
[ -t 0 ] && TTY_FLAGS=-it || TTY_FLAGS=-i

pg_running() { pg_ctl -D "$PGDATA" status >/dev/null 2>&1; }

db_init() {
    [ -f "$PGDATA/PG_VERSION" ] && return
    mkdir -p "$PGSOCK" "$DEV/backups"
    # Local-only cluster reachable through a unix socket inside the repo, so it
    # cannot collide with a system PostgreSQL and needs no passwords.
    initdb -D "$PGDATA" -U "$USER" --auth-local=trust --auth-host=trust \
           --encoding=UTF8 --locale=C.UTF-8 >/dev/null
}

db_start() {
    db_init
    pg_running && return
    mkdir -p "$PGSOCK"
    pg_ctl -D "$PGDATA" -l "$PGLOG" -w \
           -o "-k $PGSOCK -p $PGPORT -c listen_addresses=" start >/dev/null
    psql -h "$PGSOCK" -p "$PGPORT" -U "$USER" -d postgres -tAc \
         "SELECT 1 FROM pg_roles WHERE rolname='$DB_USER'" | grep -q 1 || \
        psql -h "$PGSOCK" -p "$PGPORT" -U "$USER" -d postgres -q -c \
             "CREATE ROLE $DB_USER LOGIN SUPERUSER PASSWORD '$DB_PASSWORD'"
    psql -h "$PGSOCK" -p "$PGPORT" -U "$USER" -d postgres -tAc \
         "SELECT 1 FROM pg_database WHERE datname='$DB_NAME'" | grep -q 1 || \
        psql -h "$PGSOCK" -p "$PGPORT" -U "$USER" -d postgres -q -c \
             "CREATE DATABASE $DB_NAME OWNER $DB_USER"
}

db_stop() { pg_running && pg_ctl -D "$PGDATA" -w -m fast stop >/dev/null || true; }

db_fetch() {
    local out=${1:-$DEV/backups/production.sql}
    # The only command here that authenticates against production, and the
    # production password is no longer in this repository (issue 025), so the
    # local default cannot stand in for it.
    [ -n "${KASVIMUSEO_DB_PASSWORD:-}" ] || die \
        "db fetch needs the production database password:
  KASVIMUSEO_DB_PASSWORD=... dev/kasvimuseo db fetch
It is in Ansible Vault, under ansible/host_vars/, and nowhere in this
repository in plain text. Without it, take the backup with Ansible instead:
  ansible-playbook -t backup -e backup_database=/backup-dir ansible/install.yaml"
    mkdir -p "$(dirname "$out")"
    echo "Dumping $DB_NAME from $PROD_SSH ..." >&2
    ssh "$PROD_SSH" \
        "PGPASSWORD='$DB_PASSWORD' pg_dump -h /var/run/postgresql -U $DB_USER \
         --no-owner --no-privileges $DB_NAME | gzip -9" | gunzip > "$out" || {
        rm -f "$out"
        die "Dump failed. This needs an SSH account on the production host whose
key is authorised; set KASVIMUSEO_PROD_SSH=user@host to pick another one. If you
have no SSH access, take the backup with Ansible instead and restore that file:
  ansible-playbook -t backup -e backup_database=/backup-dir ansible/install.yaml"
    }
    grep -q 'PostgreSQL database dump complete' "$out" || \
        die "$out looks truncated -- the dump did not finish."
    echo "Wrote $out ($(wc -l < "$out") lines)" >&2
}

# Makes a production dump loadable into a plain, current PostgreSQL. With
# skip_postgis=1 it also drops the PostGIS extension and the spatial_ref_sys
# table PostGIS owns.
sanitize_dump() {
    awk -v skip_postgis="${1:-0}" '
        skip_postgis && /^(CREATE|COMMENT ON) EXTENSION.*postgis/ { next }
        skip_postgis && /^COPY public\.spatial_ref_sys/ { skip = 1; next }
        skip { if ($0 == "\\.") skip = 0; next }
        # abstime was removed in PostgreSQL 12, so an index over it cannot be
        # recreated. Production is still on 10.
        /^CREATE INDEX .*abstime/ {
            print "Skipping index " $3 ": it uses abstime, removed in PostgreSQL 12." \
                > "/dev/stderr"
            next
        }
        { print }'
}

db_restore() {
    local file=${1:-} started=0
    [ -f "$file" ] || die "usage: dev/kasvimuseo db restore <dump.sql>"
    pg_running || { db_start; started=1; }
    psql -h "$PGSOCK" -p "$PGPORT" -U "$USER" -d postgres -q \
         -c "DROP DATABASE IF EXISTS $DB_NAME" \
         -c "CREATE DATABASE $DB_NAME OWNER $DB_USER"
    # Production enables PostGIS, but no table uses a spatial type, so a plain
    # PostgreSQL without it can still take the dump -- skip the extension rather
    # than make every developer install PostGIS.
    local skip_postgis=0
    if grep -qi 'EXTENSION.*postgis' "$file" && ! psql -h "$PGSOCK" -p "$PGPORT" \
            -U "$USER" -d postgres -tAc \
            "SELECT 1 FROM pg_available_extensions WHERE name='postgis'" | grep -q 1; then
        echo "PostGIS is not installed locally; skipping the unused extension." >&2
        skip_postgis=1
    fi
    sanitize_dump "$skip_postgis" < "$file" | \
        psql -h "$PGSOCK" -p "$PGPORT" -U "$DB_USER" -d "$DB_NAME" \
             -v ON_ERROR_STOP=1 -q -o /dev/null
    echo "Restored $file into $DB_NAME" >&2
    [ "$started" = 1 ] && db_stop || true
}

# The printable and compact species views make Django open the image files to
# read their dimensions, which no URL can satisfy. The media host serves the
# photos publicly, so fetch exactly the ones the database references. Python 2
# code, so it runs in the app container, not on the host.
#
# The host to fetch from is MEDIA_FALLBACK_URL, not MEDIA_URL: since issue 048
# the development MEDIA_URL is this server's own /media/, and fetching from
# there would ask the dev server for the files it is being given.
media_fetch() {
    with_db app_run_container "" python -c '
import os, sys, urllib, urllib2
from django.conf import settings
from photologue.models import Photo

base = settings.MEDIA_FALLBACK_URL or settings.MEDIA_URL
if base.startswith("//"):
    base = "https:" + base
if "://" not in base:
    sys.exit("Neither MEDIA_FALLBACK_URL nor MEDIA_URL names a host to fetch "
             "from; both are local to this installation.")
fetched = failed = present = 0
for name in Photo.objects.values_list("image", flat=True).order_by("image"):
    destination = os.path.join(settings.MEDIA_ROOT, name)
    if os.path.exists(destination):
        present += 1
        continue
    try:
        data = urllib2.urlopen(base + urllib.quote(name.encode("utf-8")),
                               timeout=60).read()
    except Exception as error:
        print("FAILED {0}: {1}".format(name.encode("utf-8"), error))
        failed += 1
        continue
    directory = os.path.dirname(destination)
    if not os.path.isdir(directory):
        os.makedirs(directory)
    with open(destination, "wb") as image_file:
        image_file.write(data)
    fetched += 1
print("{0} fetched, {1} failed, {2} already present".format(
    fetched, failed, present))
'
}

CONTAINER=kasvimuseo-dev-$$
TEST_ENV="-e DJANGO_SETTINGS_MODULE=ylaneenkasvit.test_settings"

# local_settings.py is untracked, so a fresh clone has none, and the app would
# silently fall back to production's static URL and ignore the database
# environment variables below.
#
# A copy made before a change to the template keeps its old contents forever,
# since nothing here overwrites an existing one; MEDIA_FALLBACK_URL is the
# newest setting the template gained, so say so rather than serve photos from
# production and let it be rediscovered (issue 048).
ensure_local_settings() {
    local settings=$REPO/ylaneenkasvit/local_settings.py
    if [ ! -f "$settings" ]; then
        cp "$REPO/ylaneenkasvit/local_settings.development.py" "$settings"
        echo "Created ylaneenkasvit/local_settings.py from local_settings.development.py" >&2
        return
    fi
    if ! grep -q MEDIA_FALLBACK_URL "$settings"; then
        echo "Note: your ylaneenkasvit/local_settings.py predates MEDIA_FALLBACK_URL," >&2
        echo "so photos are still loaded from the production media host. Copy the" >&2
        echo "MEDIA_* lines from ylaneenkasvit/local_settings.development.py." >&2
    fi
}

app_run_container() {
    # Without this, podman treats an unbuilt $IMAGE as a Docker Hub short name,
    # tries to pull docker.io/library/kasvimuseo-dev and fails with "requested
    # access to the resource is denied" -- which reads as a credentials problem
    # and is not one. The image is per machine, not per checkout, so a second
    # machine or a fresh account meets this on its first command.
    podman image exists "$IMAGE" || die \
        "The development image $IMAGE is not built on this machine. Build it:
  dev/kasvimuseo app build
It takes about a minute and a half. Set KASVIMUSEO_IMAGE to use another one."
    ensure_local_settings
    local extra=$1; shift
    # Named so the exit trap can reap it: podman leaves the container running if
    # its client process is killed rather than interrupted.
    podman run --rm --name "$CONTAINER" ${TTY_FLAGS:-} \
        -v "$REPO:/src" \
        -v "$PGSOCK:/var/run/postgresql" \
        -e "KASVIMUSEO_DB_PORT=$PGPORT" \
        -e "KASVIMUSEO_DB_NAME=$DB_NAME" \
        -e "KASVIMUSEO_DB_USER=$DB_USER" \
        -e "KASVIMUSEO_DB_PASSWORD=$DB_PASSWORD" \
        -e "KASVIMUSEO_SECRET_KEY=$SECRET_KEY" \
        -e "KASVIMUSEO_ALLOWED_HOSTS=$ALLOWED_HOSTS" \
        -e "KASVIMUSEO_TEST_SUFFIX=${KASVIMUSEO_TEST_SUFFIX:-}" \
        $extra "$IMAGE" "$@"
}

# The development site is served by gunicorn, the same WSGI server the
# production requirements pin, and not by `manage.py runserver`: runserver is
# wsgiref, which answers HTTP/1.0 without a Content-Length, so the length of a
# response is whatever arrived before the connection closed. A truncated page
# is then indistinguishable from a complete one for both the browser and curl
# -- which is how issue 044 stayed a mystery for as long as it did. gunicorn
# sends a Content-Length and a client notices a short read.
#
# What is lost is the autoreloader: gunicorn 0.17.4 has no --reload, so after
# editing Python either restart this command or reload the workers in place:
#
#     podman kill --signal HUP $(podman ps -qf name=kasvimuseo-dev-)
#
# Templates and static files are re-read per request either way. `--runserver`
# brings the old server back for a session that wants the autoreloader; see
# README.rst.
#
# The container shares the host's network namespace rather than publishing a
# port, because publishing it is what truncated the responses in issue 044.
# Rootless podman publishes with pasta, and pasta -- on this host, over a
# connection with real latency -- forwards about 43 KB of a response and then
# closes it cleanly, losing the rest. A packet capture on the receiving machine
# shows the server's own FIN riding the segment that ends at byte 43,140, with
# every segment before it acknowledged and nothing retransmitted. Responses
# small enough to be forwarded before the application closes its socket survive,
# and so do ones too large to be buffered at all, which is why the failure looked
# like a size threshold with exceptions at both ends. `--publish` restores the
# published port for anyone who wants to see that happen.
app_serve() {
    local runserver=0 network=--network=host bind=${KASVIMUSEO_PORT:-8000}
    while [ $# -gt 0 ]; do
        case $1 in
            --runserver) runserver=1 ;;
            --publish)   network=-p\ ${KASVIMUSEO_PORT:-8000}:8000; bind=8000 ;;
            *) die "usage: dev/kasvimuseo app run [--runserver] [--publish]" ;;
        esac
        shift
    done
    if [ "$runserver" = 1 ]; then
        with_db app_run_container "$network" \
            python ylaneenkasvit/manage.py runserver "0.0.0.0:$bind"
    else
        # One worker keeps the log readable and matches runserver's behaviour
        # under a single developer; --timeout is generous because the largest
        # change forms take a couple of seconds and a debugger pauses longer.
        with_db app_run_container "$network" \
            gunicorn ylaneenkasvit.wsgi:application \
                --bind "0.0.0.0:$bind" --workers 1 --timeout 300 \
                --access-logfile - --error-logfile -
    fi
}

# The label editor's browser tests (issue 017). Two interpreters, and that is
# the point: the application is Django 1.5 on Python 2.7, nothing that drives a
# current browser supports 2.7, and the browser this page has to be right in is
# not one a 2020 Chromium can stand in for. So the server is the real
# application in its own container and the tests are Python 3 on the host,
# through uv, talking to it over HTTP -- the same split `docs` already uses.
#
# Everything it touches is thrown away: its own database, seeded from
# browser_tests/seed.py, and its own MEDIA_ROOT under .dev/. The developer's
# ylaneenkasvit database and media/ are not read or written, and neither is
# local_settings.py -- the server runs on ylaneenkasvit.test_settings, which is
# built on common_settings for that reason.
BROWSER_DB=${KASVIMUSEO_BROWSER_DB_NAME:-${DB_NAME}_browsertest}
BROWSER_ENV="-e DJANGO_SETTINGS_MODULE=ylaneenkasvit.test_settings"
BROWSER_ENV="$BROWSER_ENV -e KASVIMUSEO_MEDIA_ROOT=/src/.dev/browser-test-media"

# The server shares the host's network namespace, as `app run` does (issue
# 044), so it needs a port nothing else on this machine is on. Set
# KASVIMUSEO_BROWSER_PORT to pin one.
free_port() {
    local port
    for port in $(seq 8123 8199); do
        (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null && exec 3<&- || {
            echo "$port"; return; }
    done
    die "no free port between 8123 and 8199"
}

# Wipe the browser tests' database back to what seed.py describes. Its own
# command because the tests call it between themselves: the editor's save
# rewrites every label, so a test that saves would otherwise decide what the
# next one sees.
browser_seed() {
    TTY_FLAGS=
    DB_NAME=$BROWSER_DB
    app_run_container "$BROWSER_ENV" python browser_tests/seed.py
}

browser_test() {
    command -v uv >/dev/null 2>&1 || die \
        "app browser-test needs uv on the host: https://docs.astral.sh/uv/"
    # Detached and interactive are a bad pair, and the server runs in the
    # background of this script.
    TTY_FLAGS=
    DB_NAME=$BROWSER_DB
    local port=${KASVIMUSEO_BROWSER_PORT:-$(free_port)}
    pg_running || { db_start; DB_STARTED=1; }
    psql -h "$PGSOCK" -p "$PGPORT" -U "$USER" -d postgres -q \
         -c "DROP DATABASE IF EXISTS $BROWSER_DB" \
         -c "CREATE DATABASE $BROWSER_DB OWNER $DB_USER"
    BROWSER_DB_MADE=1
    # photologue first, as in `db bootstrap`: kasvimuseo:0014 references
    # photologue_photo. syncdb also loads photologue's initial data, which is
    # where the `display` photo size the labels render comes from.
    #
    # syncdb prints a DatabaseError about initial_data.json on the way, exactly
    # as `db bootstrap` does: the project fixture names photologue rows, and
    # photologue's tables are South's, so they are not there yet. South loads
    # the same fixture again after migrating, which is why this is noise rather
    # than a failure -- hence `;` and not `&&` after it.
    app_run_container "$BROWSER_ENV" sh -c \
        'python ylaneenkasvit/manage.py syncdb --noinput >/dev/null;
         python ylaneenkasvit/manage.py migrate photologue --noinput >/dev/null &&
         python ylaneenkasvit/manage.py migrate --noinput >/dev/null'
    browser_seed

    echo "Serving $BROWSER_DB on port $port ..." >&2
    app_run_container "$BROWSER_ENV --network=host" \
        gunicorn ylaneenkasvit.wsgi:application \
            --bind "127.0.0.1:$port" --workers 2 --timeout 60 \
            --access-logfile /dev/null --error-logfile - &
    local url=http://127.0.0.1:$port waited=0
    until curl -sfo /dev/null "$url/kasvimuseo/planting-labels/"; do
        waited=$((waited + 1))
        [ "$waited" -lt 60 ] || die "the server did not answer on $url"
        sleep 0.5
    done

    # --no-project: the repository's own setup.py is a Python 2 package and has
    # nothing to do with these tests.
    KASVIMUSEO_BROWSER_TEST_URL=$url \
    KASVIMUSEO_BROWSER_TEST_SEED="$REPO/dev/kasvimuseo app browser-seed" \
    uv run --no-project --with-requirements "$REPO/browser_tests/requirements.txt" \
        pytest "$REPO/browser_tests" "$@"
}

# Starts the cluster if needed and stops it again afterwards.
DB_STARTED=0
BROWSER_DB_MADE=0
cleanup() {
    podman rm -f -t 3 "$CONTAINER" >/dev/null 2>&1 || true
    # The browser tests' database outlives nothing: dropped here so a failed run
    # leaves no half-seeded copy behind either.
    [ "$BROWSER_DB_MADE" = 1 ] && pg_running && \
        psql -h "$PGSOCK" -p "$PGPORT" -U "$USER" -d postgres -q \
             -c "DROP DATABASE IF EXISTS $BROWSER_DB" >/dev/null 2>&1 || true
    [ "$DB_STARTED" = 1 ] && db_stop || true
}
trap cleanup EXIT
with_db() {
    pg_running || { db_start; DB_STARTED=1; }
    "$@"
}

case "${1:-}" in
  db)
    case "${2:-}" in
      start)   db_start; echo "PostgreSQL up on $PGSOCK (port $PGPORT)" ;;
      stop)    db_stop; echo "PostgreSQL stopped" ;;
      status)  pg_ctl -D "$PGDATA" status ;;
      psql)    shift 2; with_db psql -h "$PGSOCK" -p "$PGPORT" -U "$DB_USER" -d "$DB_NAME" "$@" ;;
      fetch)   db_fetch "${3:-}" ;;
      bootstrap)
               # Empty database from the migrations, for working without a
               # production dump. photologue must go first: kasvimuseo:0014
               # references photologue_photo.
               with_db app_run_container "" sh -c \
                 'python ylaneenkasvit/manage.py syncdb --noinput;
                  python ylaneenkasvit/manage.py migrate photologue --noinput &&
                  python ylaneenkasvit/manage.py migrate --noinput' ;;
      restore) db_restore "${3:-}" ;;
      reset)   db_stop; rm -rf "$PGDATA"; echo "Cluster deleted" ;;
      *)       die "usage: dev/kasvimuseo db start|stop|status|psql|fetch|restore|bootstrap|reset" ;;
    esac ;;
  media)
    case "${2:-}" in
      fetch)   media_fetch ;;
      *)       die "usage: dev/kasvimuseo media fetch" ;;
    esac ;;
  app)
    case "${2:-}" in
      build)   podman build -f "$REPO/dev/Containerfile" -t "$IMAGE" "$REPO" ;;
      run)     shift 2; app_serve "$@" ;;
      manage)  shift 2; with_db app_run_container "" python ylaneenkasvit/manage.py "$@" ;;
      # Most tests build their own data in a test database, so unlike the app
      # itself they need the cluster but never a production dump or media.
      # The image sets DJANGO_SETTINGS_MODULE for the app, and pytest-django
      # lets the environment outrank pytest.ini, so point it at the test
      # settings explicitly.
      test)    shift 2; with_db app_run_container "$TEST_ENV" \
                   python -m pytest "$@" ;;
      browser-test)
               shift 2; browser_test "$@" ;;
      browser-seed)
               browser_seed ;;
      coverage)
               shift 2; with_db app_run_container "$TEST_ENV" sh -c \
                 "coverage run --source=kasvimuseo,ylaneenkasvit \
                               --omit='*/migrations/*,*/tests/*,\
*/external_migrations/*,*/manage.py,*/wsgi.py,*/*settings*.py' \
                               -m pytest -q $* >/dev/null;
                  coverage report -m" ;;
      shell)   with_db app_run_container "" sh ;;
      *)       die "usage: dev/kasvimuseo app build|run|manage|test|browser-test|browser-seed|coverage|shell" ;;
    esac ;;
  docs)
    case "${2:-}" in
      serve)   shift 2; exec "$REPO/dev/docs-serve" "$@" ;;
      *)       shift; "$REPO/dev/docs-build" "$@" ;;
    esac ;;
  *) sed -n '2,22p' "${BASH_SOURCE[0]}" | cut -c3- ;;
esac
