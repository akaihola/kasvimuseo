# Development image: Python 2.7 + the app's dependencies, but NO app code.
# The working copy is bind-mounted at /src so edits take effect immediately.
FROM docker.io/library/python:2.7-alpine

RUN apk add --no-cache jpeg-dev zlib-dev libpq postgresql-dev gcc musl-dev python2-dev

COPY requirements /tmp/requirements
# One install, one file -- dev.txt, which is production.txt plus the two
# development-only tools. It used to be production.txt alone, which was the
# same set until upgrade plan Stage 0 moved `django-extensions` out of
# production: this is a development image, and
# `local_settings.development.py` puts that app into INSTALLED_APPS, so the
# image has to have it. production.txt names every *runtime* package at an
# exact version, Pillow included, so the second `pip install` this line used to
# carry is gone -- that was issue 027, and the bounds it explained are beside
# the pins they belong to. `--no-deps` no longer changes what lands here:
# measured, `pip install -r dev.txt` without it resolves the same packages,
# because the only transitive requirements in the set are photologue's
# `Pillow>=2.0.0` and django-extensions' `six>=1.2`, and the files pin both.
# It stays as the guard that keeps that true -- with it, a package that grows a
# new dependency fails at import, loudly and in this image, instead of quietly
# installing something unpinned and unbounded, which is the failure issue 027
# is about.
RUN pip install --no-cache-dir --no-deps -r /tmp/requirements/dev.txt

# Django 1.5.1 listed its locale catalogs, fixtures and project_template in
# setup.py's `data_files` rather than `package_data`. That setup.py redirected
# the `data` install scheme to `purelib` so they still landed inside the
# package -- but only when pip ran `setup.py install`; the wheel pip builds
# here ignored the redirection and dropped them in /usr/local/django, where
# gettext never looks and the admin chrome stayed English (issue 040).
#
# Django 1.5.12 -- upgrade plan Stage 1 -- collects them as `package_data` and
# redirects nothing, so there is no stray tree to move any more: measured on
# this image, /usr/local/django does not exist and both `fi` catalogs are
# inside the package. The `cp` below is therefore a no-op today and stays as
# the repair for a Django that puts them beside the package again; the `test
# -f` is the part that still does work, and it now asserts that Django
# packaged them rather than that this file moved them. Either way the build
# fails instead of shipping an English admin.
RUN set -e; \
    prefix=/usr/local; \
    pkg=$prefix/lib/python2.7/site-packages/django; \
    if [ -d "$prefix/django" ]; then \
        cp -a "$prefix/django"/. "$pkg"/; \
        rm -rf "$prefix/django"; \
    fi; \
    for mo in conf/locale/fi contrib/admin/locale/fi; do \
        test -f "$pkg/$mo/LC_MESSAGES/django.mo" || { \
            echo "issue 040: $pkg/$mo/LC_MESSAGES/django.mo is missing and" \
                 "there is no $prefix/django to take it from -- find where" \
                 "pip put Django's data_files" >&2; \
            exit 1; \
        }; \
    done

# Test dependencies, as pinned in setup.py's tests_require.
RUN pip install --no-cache-dir 'pytest==3.5.0' 'pytest-django==2.9.1' \
                               'coverage==4.5.4' \
                               'mock==2.0.0' 'pbr==4.0.2'

ENV PYTHONPATH=/src \
    PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=ylaneenkasvit.ylaneenkasvit_settings \
    KASVIMUSEO_DEBUG=1
WORKDIR /src
