#!/usr/bin/env python3
"""Serve the built documentation of every checkout of this repository.

The main checkout and each ``git worktree`` get their own path -- ``/master/``,
``/sphinx-docs/``, ... -- served from that checkout's ``.dev/docs/html/``, with
an index at ``/`` and a switcher on every page that keeps your place when you
move between them. Checkouts are re-read on every request, so a worktree added
or removed while this is running needs no restart.

Binds to the machine's Tailscale address when there is one, so the docs are
readable from the tailnet and nowhere else. Stdlib only: no dependency on the
documentation toolchain, and nothing to install.

Usage: dev/docs-serve [--port N] [--bind ADDR]
"""

import argparse
import html
import mimetypes
import subprocess
import sys
from datetime import datetime
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import quote, unquote

REPO = Path(__file__).resolve().parent.parent
DOCS_SUBPATH = Path(".dev/docs/html")


def checkouts():
    """The main checkout and every worktree, in ``git worktree list`` order."""
    listing = subprocess.run(
        ["git", "worktree", "list", "--porcelain"],
        cwd=REPO, capture_output=True, text=True,
    ).stdout

    found, current = [], {}
    for line in listing.splitlines() + [""]:
        if line.startswith("worktree "):
            current = {"path": Path(line[len("worktree "):])}
        elif line.startswith("branch "):
            current["name"] = line[len("branch "):].rsplit("/", 1)[-1]
        elif not line.strip() and current:
            found.append(current)
            current = {}

    for checkout in found:
        # A detached checkout has no branch to name it; use its directory.
        checkout.setdefault("name", checkout["path"].name)
        checkout["root"] = checkout["path"] / DOCS_SUBPATH
        checkout["index"] = checkout["root"] / "index.html"
    # Checkouts are named by branch, which is what one actually wants to read --
    # but the main checkout's branch changes under you, so it answers at the
    # fixed /main/ as well and a bookmark to it keeps working.
    if found:
        found[0]["alias"] = "main"
    return found


def switcher(names, active, rest):
    """A bar linking to the same page in the other checkouts.

    Injected into responses, never written to disk: the built HTML stays exactly
    what Sphinx produced.
    """
    options = "".join(
        '<option value="/{name}/{rest}"{sel}>{label}</option>'.format(
            name=quote(name), rest=quote(rest),
            sel=" selected" if name == active else "",
            label=html.escape(name),
        )
        for name in names
    )
    return """
<style>
#checkout-switcher {{ position: fixed; bottom: 0; right: 0; z-index: 999;
  font: 12px/1.6 system-ui, sans-serif; background: #2b2b2b; color: #eee;
  padding: .3em .6em; border-top-left-radius: .4em; opacity: .85; }}
#checkout-switcher:hover {{ opacity: 1; }}
#checkout-switcher select {{ font: inherit; }}
</style>
<div id="checkout-switcher">checkout
  <select onchange="location.href=this.value">{options}</select>
  <a href="/" style="color:#9cf">all</a>
</div>
""".format(options=options)


def landing(found):
    rows = []
    for checkout in found:
        if checkout["index"].exists():
            when = datetime.fromtimestamp(
                checkout["index"].stat().st_mtime
            ).strftime("%Y-%m-%d %H:%M")
            state = '<a href="/{}/">open</a> <span class="t">built {}</span>'.format(
                quote(checkout["name"]), when
            )
        else:
            state = '<span class="t">not built &mdash; run <code>dev/kasvimuseo docs</code> there</span>'
        name = html.escape(checkout["name"])
        if checkout.get("alias"):
            name += ' <span class="t">also /{}/</span>'.format(checkout["alias"])
        rows.append(
            "<tr><th>{}</th><td>{}</td><td class=t>{}</td></tr>".format(
                name, state, html.escape(str(checkout["path"]))
            )
        )

    return """<!doctype html>
<html><head><meta charset="utf-8"><title>Ylåneen kasvit documentation</title>
<style>
 body {{ font: 15px/1.6 system-ui, sans-serif; margin: 3em auto; max-width: 46em; }}
 table {{ border-collapse: collapse; width: 100%; }}
 th, td {{ text-align: left; padding: .4em .8em .4em 0; vertical-align: top; }}
 tr + tr {{ border-top: 1px solid #ddd; }}
 .t {{ color: #666; font-size: 90%; }}
</style></head><body>
<h1>Ylåneen kasvit documentation</h1>
<p>One entry per checkout of the repository. Each is built independently by
<code>dev/kasvimuseo docs</code> in that checkout; this only serves what is
there.</p>
<table>{rows}</table>
</body></html>
""".format(rows="".join(rows))


class Handler(SimpleHTTPRequestHandler):
    def do_GET(self):
        found = checkouts()
        path = unquote(self.path.split("?", 1)[0].split("#", 1)[0])
        segment, _, rest = path.lstrip("/").partition("/")

        if not segment:
            return self.send_html(landing(found).encode())

        checkout = next(
            (c for c in found if segment in (c["name"], c.get("alias"))), None
        )
        if checkout is None:
            return self.send_error(404, "No checkout named %r" % segment)

        target = (checkout["root"] / rest).resolve()
        if target.is_dir():
            target = target / "index.html"
        if not str(target).startswith(str(checkout["root"].resolve())):
            return self.send_error(403, "Outside the documentation root")
        if not target.is_file():
            hint = "not built yet" if not checkout["index"].exists() else "no such page"
            return self.send_error(404, "%s in %s" % (hint, segment))

        body = target.read_bytes()
        kind = mimetypes.guess_type(target.name)[0] or "application/octet-stream"
        if kind == "text/html":
            relative = str(target.relative_to(checkout["root"]))
            bar = switcher([c["name"] for c in found], segment, relative)
            body = body.replace(b"</body>", bar.encode() + b"</body>", 1)
        return self.send_html(body, kind)

    def send_html(self, body, kind="text/html"):
        self.send_response(200)
        self.send_header("Content-Type", kind + ("; charset=utf-8" if kind.startswith("text/") else ""))
        self.send_header("Content-Length", str(len(body)))
        # The docs are rebuilt constantly; never let a browser hold on to a page.
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, fmt, *args):
        sys.stderr.write("%s %s\n" % (self.address_string(), fmt % args))


def tailscale_address():
    try:
        out = subprocess.run(
            ["tailscale", "ip", "-4"], capture_output=True, text=True, timeout=5
        )
    except (OSError, subprocess.SubprocessError):
        return None
    return out.stdout.split()[0] if out.returncode == 0 and out.stdout.strip() else None


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--port", type=int, default=8800)
    parser.add_argument(
        "--bind",
        help="address to listen on (default: this machine's Tailscale address, "
             "or 0.0.0.0 if Tailscale is not reachable)",
    )
    args = parser.parse_args()

    address = args.bind or tailscale_address()
    if address is None:
        address = "0.0.0.0"
        print("docs: no Tailscale address found, listening on every interface",
              file=sys.stderr)

    server = ThreadingHTTPServer((address, args.port), Handler)
    print("docs: http://%s:%d/" % (address, args.port))
    for checkout in checkouts():
        print("  /%s/%s" % (
            checkout["name"],
            "" if checkout["index"].exists() else "   (not built)",
        ))
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
