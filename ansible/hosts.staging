# Throwaway staging host for the issue 070 rehearsal of the security window.
#
# Run against it explicitly, never through the production runbook:
#
#     export ANSIBLE_VAULT_PASS=***********
#     ansible-playbook -i ansible/hosts.staging \
#       -e @ansible/vars/staging.yml ansible/install.yaml
#
# This is a SEPARATE inventory on purpose. ansible/hosts stays single-host so
# the production playbooks' `hosts: all` can never reach a staging box by
# accident. Nothing here is loaded unless you pass -i ansible/hosts.staging.
#
# staging-rehearsal is the reused Hetzner CX11 "lead-1", wiped and booted from
# a Debian 10 cloud image for the 2026-08-09 reduced rehearsal (README.rst,
# "Rehearsing the window on a throwaway host"). Its vaulted secrets file is
# ansible/host_vars/staging-rehearsal, untracked on purpose: its vault
# password is the operator's throwaway one, not production's. The Python 2.7
# interpreter is the one production's era of these playbooks assumes; the
# host prep that makes it work is in the README section named above.
[staging]
staging-rehearsal ansible_host=135.181.83.114 ansible_python_interpreter=/usr/bin/python2.7 ansible_ssh_private_key_file=~/.ssh/id_rsa
