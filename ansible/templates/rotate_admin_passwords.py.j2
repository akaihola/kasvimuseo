"""Set the password of each named account, without ever echoing it.

Rendered by ``ansible/secure-production.yaml`` and handed to the server's
Python 2.7 on **standard input** (``python2.7 -``), which is the whole point of
the file: the passwords in it never reach an argument list (``ps``), a process
environment (``/proc/PID/environ``), the play's output (``no_log``) or a file
this repository tracks (they come from the vault). See issue 050.

Idempotent: an account whose stored hash already verifies the new password is
left alone and reported as ``unchanged``, so a second run rotates nothing. With
``dry_run`` it reports what it would do and writes nothing, which is what
``--check`` and the verification play use.

The output is one JSON object on stdout, and it contains user names only --
never a password and never a password hash.

Python 2.7 (the deployed interpreter), written in the subset that also parses
on Python 3 so the repository's own tooling can check it.
"""
import json
import os
import sys

# Rendered by Jinja: a JSON document can never contain three consecutive
# double quotes, so the raw triple-quoted string cannot be closed early by it.
PARAMS = json.loads(r"""{{ rotate_params | to_json }}""")

os.environ['DJANGO_SETTINGS_MODULE'] = PARAMS['settings_module']
for _name, _value in PARAMS['environment'].items():
    os.environ[_name] = _value

try:
    from django.contrib.auth.models import User
except ImportError as error:
    sys.stderr.write('cannot import Django from %s: %s\n' % (sys.prefix, error))
    raise SystemExit(2)

if PARAMS['dry_run'] not in (True, False):
    # A JSON boolean, or nothing: "False" as a string is true in Python, and
    # this is the flag that decides whether anything is written at all.
    sys.stderr.write('dry_run is %r, not a boolean\n' % (PARAMS['dry_run'],))
    raise SystemExit(6)

result = {
    'dry_run': PARAMS['dry_run'],
    'changed': [],
    'unchanged': [],
    'missing': [],
}

try:
    for username in sorted(PARAMS['passwords']):
        new_password = PARAMS['passwords'][username]
        try:
            user = User.objects.get(username=username)
        except User.DoesNotExist:
            result['missing'].append(username)
            continue
        if user.check_password(new_password):
            # Already the password in the vault. Nothing to do, and saying so
            # is also how the verification play proves the old one is dead: a
            # Django hash verifies exactly one plaintext.
            result['unchanged'].append(username)
            continue
        if PARAMS['dry_run']:
            result['changed'].append(username)
            continue
        user.set_password(new_password)
        user.save()
        if not User.objects.get(pk=user.pk).check_password(new_password):
            sys.stderr.write('%s: the new password did not take\n' % username)
            raise SystemExit(4)
        result['changed'].append(username)
except Exception as error:  # noqa: BLE001 -- the message is the useful part
    text = str(error)
    sys.stderr.write('%s: %s\n' % (type(error).__name__, text))
    if 'password authentication' in text or 'authentication failed' in text:
        sys.stderr.write(
            'The database refused the password from the vault. That is what it'
            ' looks like when the deploy that carries it has not run yet: run'
            ' the whole of ansible/secure-production.yaml, not just this tag.'
            ' See docs/issues/049-*.rst.\n')
    raise SystemExit(3)

print(json.dumps(result, sort_keys=True))

if result['missing']:
    sys.stderr.write(
        'no such account: %s -- check the user names in'
        ' kasvimuseo_admin_passwords against the audit below\n'
        % ', '.join(result['missing']))
    raise SystemExit(5)
