# What `dev/kasvimuseo app coverage` measures, and the floor it refuses to fall
# below (issue 064).
#
# In a file rather than as flags inside `dev/kasvimuseo`, because the number is
# an argument and an argument wants somewhere to be written down. Both halves
# of the gate -- the developer's command and the CI step in
# .github/workflows/tests.yml -- run `coverage` from the repository root, so
# both read this and neither can measure something the other does not.

[run]
# The two Python packages this repository owns. `ylaneenkasvit` is in the list
# because leaving it out is how ylaneenkasvit/dashboard.py sat at 0% unnoticed
# (docs/test-coverage-plan.rst, "Second round").
source = kasvimuseo,ylaneenkasvit

# Four kinds of file, and a reason each:
#
#   migrations/  Django migrations, which pytest-django replays into the test
#                database before the first test and which no test imports.
#                They read as covered or uncovered depending on the run rather
#                than on the suite, so measuring them says nothing. This line
#                used to name a South chain and SOUTH_TESTS_MIGRATE = False;
#                upgrade plan Stage 5 ended South, and Stage 7's Django 1.9
#                deleted the `syncdb` that sentence relied on.
#   tests/       Measuring the tests measures whether the tests ran, which the
#                suite already reports, and inflates the total with a thousand
#                statements that are covered by construction.
#   manage.py    Entry points and configuration. They are executed to import
#   wsgi.py      the settings under test, so they would score high while
#   *settings*   asserting nothing; test_settings.py in particular would be
#                measuring the measurement.
#
# Nothing else is omitted, and one candidate was refused on purpose. The
# vendored fork of Django's admin_list, kasvimuseo/templatetags/
# kasvimuseo_admin_list.py, sat at 91% and was 139 statements; dropping those
# out of the measurement to protect the number would have been the opposite of
# a gate. Upgrade plan Stage 5 deleted the file instead, and the total rose
# rather than needing to be renegotiated, which is what this paragraph
# predicted.
omit =
    */migrations/*
    */tests/*
    */manage.py
    */wsgi.py
    */*settings*.py

[report]
# The gate: one floor on the total, not a per-file minimum.
#
# Today's total is 99.16% -- 823 of 830 statements, measured on 2026-08-17 at
# upgrade plan Stage 7. The floor was chosen against 97.87% -- 920 of 940
# statements on 2026-08-03, written out in docs/test-coverage-plan.rst under
# "Where coverage stands" -- and 97 is deliberately just under that number.
# Both neighbouring choices were considered and rejected:
#
#   * A floor **at** today's number turns every unrelated pull request into a
#     coverage negotiation: one defensive `except` branch nobody can trigger
#     is enough to go red.
#   * A floor far below it -- the plan's own "≥ 80% overall" target -- gates
#     nothing. The suite could lose a sixth of its reach and stay green.
#
# What that headroom buys, measured rather than guessed (issue 064 has the
# runs): this suite overlaps heavily, so deleting any one test module costs
# only about six statements and stays green -- test_templatetags.py,
# test_admin_changelist.py and test_project_urls.py each cost exactly six.
# Three of them together cost 18, reach 95.96 % and fail. So the floor is not a
# tripwire on one test file; it catches a module dropping out of the suite
# altogether, and new code arriving with no tests. Tightening it to 98 would
# make it a tripwire and make it 0.37 points from today, which is the
# negotiation this floor exists to avoid. Raise it when the total has been
# comfortably above the next integer for a while; do not raise it in the same
# pull request that earns the increase.
#
# The floor used to be half a point looser than it read, and `precision` below
# is what closed that gap. **coverage compares the rounded percentage unless
# `precision` is set**, so under the coverage 4.5.4 this file was written
# against, `fail_under = 97` refused nothing above 96.5%. Measured then rather
# than assumed: at 97.87%, `coverage report --fail-under=98` passed and
# `--fail-under=99` failed.
#
# Upgrade plan Stage 7 moved the pin to coverage 5.5 -- the last release that
# runs on Python 2.7, so this did not wait for the Python 3 flip the way this
# paragraph used to predict -- and 5.5 has the `precision` setting 4.5.4 has no
# equivalent of. Measured in the Stage 7 image on a module at an exact 96.77%:
# with no `precision`, `fail_under = 97` exits 0; with `precision = 2` it exits
# 2. The command line is not the place to set it, also measured --
# `coverage report --fail-under=97 --precision=2` exits 0, and only the value in
# this file reaches the comparison.
#
# So 97 now means 97, and the number did not have to move to mean it. The
# headroom above is two points rather than one and a half.
#
# Per-file minimums were the other candidate and were rejected. Twenty-one
# files each with a number is twenty-one numbers to maintain, and coverage
# cannot express them at all: `coverage report --help` on 5.5 offers
# `--fail-under` on the total and nothing per file.
fail_under = 97

# What makes `fail_under` above mean 97 rather than 96.5. Upgrade plan Stage 7
# is where this became available; the paragraph above has the measurement.
precision = 2

show_missing = True
