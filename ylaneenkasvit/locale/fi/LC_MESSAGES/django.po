#: dashboard.py:58
msgid "Administration"
msgstr "Ylläpito"

#: dashboard.py:67
msgid "Reports and tools"
msgstr "Raportit ja työkalut"

#: dashboard.py:71
msgid "Planted species"
msgstr "Istutetut kasvit"

#: dashboard.py:74
msgid ""
"The mobile plant list: every publicly planted species with its photo, "
"leading to the species pages"
msgstr ""
"Mobiili kasviluettelo: jokainen julkiseen penkkiin istutettu laji kuvineen, "
"josta pääsee lajin tietosivulle"

#: dashboard.py:76
msgid "Species sheets"
msgstr "Kasvilajien tietosivut"

#: dashboard.py:79
msgid "Tick the species in the list and run the \"Create Species Sheets\" action"
msgstr ""
"Rastita lajit luettelosta ja suorita toiminto \"Luo kasvilajien tietosivut\""

#: dashboard.py:81
msgid "Planting labels"
msgstr "Kyltit"

#: dashboard.py:84
msgid ""
"Choose the photo and the visibility of each label to be printed for the beds"
msgstr "Valitse penkkeihin tulostettavien kylttien kuvat ja näkyvyys"

#: dashboard.py:86
msgid "Photo galleries"
msgstr "Kuvagalleriat"

#: dashboard.py:89
msgid "The public Photologue galleries"
msgstr "Julkiset Photologue-kuvagalleriat"

#: dashboard.py:95
msgid "Bed maps"
msgstr "Penkkikartat"

#: dashboard.py:107
msgid "Recent Actions"
msgstr "Viimeisimmät muutokset"
