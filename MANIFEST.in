recursive-include */locale *.po
recursive-include */locale *.mo
recursive-include ylaneenkasvit/templates *.html
include requirements/production.txt
recursive-include kasvimuseo/templates *.html
graft kasvimuseo/static
graft jqm/templates
graft jqm/static
include jqm/README.rst
# The MIT notice for the vendored django-jqm (task 7).
include jqm/LICENSE
# Machine-specific settings never go into a source distribution (task 1).
# setup.py's build_py drops them from the module list; this is the second gate.
exclude ylaneenkasvit/local_settings*.py
exclude ylaneenkasvit/kajala_settings.py
